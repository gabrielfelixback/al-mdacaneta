ANTHROPIC_API_KEY=
PORT=8787
# Chave compartilhada que o app envia no cabeçalho x-app-key (defina também EXPO_PUBLIC_APP_KEY no app)
APP_API_KEY=
# Origens do navegador liberadas, separadas por vírgula (vazio = todas; defina em produção)
ALLOWED_ORIGINS=
# 1 quando o servidor roda atrás de proxy/load balancer (usa X-Forwarded-For para o limite por IP)
TRUST_PROXY=
