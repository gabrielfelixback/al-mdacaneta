# =====================================================================
# Alem da Caneta - variaveis do backend (Supabase Edge Functions)
# Nunca comite o .env real. Em producao, use os Secrets do projeto Supabase
# (supabase secrets set ...). Segredos ficam FORA do codigo.
# =====================================================================

# Supabase (Project Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=coloque-a-anon-key
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key   # SECRETA: so no servidor

# CORS: origens liberadas para o app web (separadas por virgula).
# Deixe vazio apenas em dev; defina em producao.
ALLOWED_ORIGINS=

# Mercado Pago
MP_ACCESS_TOKEN=coloque-o-access-token
MP_WEBHOOK_SECRET=coloque-o-segredo-do-webhook

# Stripe (opcional, segundo gateway plugavel)
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
